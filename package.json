{
  "name": "foreverfile",
  "version": "0.1.0",
  "description": "A permanent place for important files. Publish a public record that cannot silently change.",
  "license": "MIT",
  "author": "Sven Anders Robbestad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robbestad/foreverfile.git"
  },
  "homepage": "https://github.com/robbestad/foreverfile",
  "bugs": {
    "url": "https://github.com/robbestad/foreverfile/issues"
  },
  "keywords": [
    "arweave",
    "permaweb",
    "permanent-storage",
    "svenjs"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && node ./scripts/prerender.mjs",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir .vite/prerender --emptyOutDir",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "arweave": "^1.15.7",
    "svenjs": "3.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^20",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.2.4",
    "vitest": "^4.1.11"
  }
}
